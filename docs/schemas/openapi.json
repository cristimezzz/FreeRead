  "components": {
    "schemas": {
      "AppSettings": {
        "properties": {
          "appearance": {
            "$ref": "#/components/schemas/Appearance",
            "default": {
              "theme_mode": "system",
              "seed_color": "#6750A4",
              "follow_system_accent": false,
              "contrast": "standard"
            }
          },
          "target_lang": {
            "type": "string",
            "title": "Target Lang",
            "default": "zh-CN"
          },
          "parse_engine": {
            "type": "string",
            "enum": [
              "auto",
              "pymupdf",
              "mineru",
              "docling"
            ],
            "title": "Parse Engine",
            "default": "auto"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderConfig"
            },
            "type": "array",
            "title": "Providers",
            "default": []
          },
          "routes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ModelRoute"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/TaskKind"
            },
            "type": "object",
            "title": "Routes",
            "default": {}
          },
          "consented_providers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Consented Providers",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AppSettings"
      },
      "Appearance": {
        "properties": {
          "theme_mode": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "title": "Theme Mode",
            "default": "system"
          },
          "seed_color": {
            "type": "string",
            "title": "Seed Color",
            "default": "#6750A4"
          },
          "follow_system_accent": {
            "type": "boolean",
            "title": "Follow System Accent",
            "default": false
          },
          "contrast": {
            "type": "string",
            "enum": [
              "standard",
              "medium",
              "high"
            ],
            "title": "Contrast",
            "default": "standard"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Appearance"
      },
      "CollectionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "zotero_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zotero Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "zotero_key",
          "name",
          "parent_id",
          "item_count"
        ],
        "title": "CollectionOut",
        "description": "扁平列表，前端按 parent_id 组装分类树。"
      },
      "DocRef": {
        "properties": {
          "attachment_id": {
            "type": "string",
            "title": "Attachment Id"
          },
          "doc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "parse_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parse Status"
          }
        },
        "type": "object",
        "required": [
          "attachment_id",
          "doc_id",
          "filename",
          "parse_status"
        ],
        "title": "DocRef"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportFileRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "ImportFileRequest"
      },
      "ImportFileResult": {
        "properties": {
