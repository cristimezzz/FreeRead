{
  // docs.freeread.work：Cloudflare Workers Builds 在 wiki/ 下运行 npm run build，再 npx wrangler deploy。
  // 没有这个文件时 wrangler 会把 VitePress 的输出目录猜成 docs/.vitepress/dist。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeread",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".vitepress/dist",
    // cleanUrls：/install 对应 install.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
