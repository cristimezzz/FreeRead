{
  "name": "freeread",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22.13.0", "pnpm": ">=11" },
  "scripts": {
    "dev": "pnpm --filter @freeread/desktop dev",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "spec:check": "node specs/tools/check-specs.mjs",
    "typecheck": "tsc --build --force",
    "lint": "eslint apps packages scripts *.mjs && pnpm boundaries",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run --coverage && node --test scripts/*.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:cold-start": "node scripts/cold-start.mjs",
    "build": "turbo run build && pnpm --filter @freeread/desktop bundle",
    "build:dist": "pnpm build && pnpm license && pnpm license:source-offer && node scripts/build-manifest.mjs && pnpm --filter @freeread/desktop dist",
    "license": "node scripts/license.mjs",
    "license:notices": "node scripts/license.mjs",
    "license:source-offer": "node scripts/source-offer.mjs",
    "forbid": "node scripts/forbid-domains.mjs",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "size": "node scripts/size.mjs",
    "verify": "pnpm spec:check && pnpm typecheck && pnpm lint && pnpm test && pnpm gen:check && pnpm license && pnpm forbid && pnpm fixtures:check",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.5.0",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
